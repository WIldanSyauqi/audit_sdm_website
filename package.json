{
  "name": "audit-sdm-production",
  "version": "1.0.0",
  "description": "Production-ready audit SDM backend with auth, RBAC, audit log, and backup support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "db:backup": "node scripts/backup-db.js",
    "start:prod": "NODE_ENV=production node server.js"
