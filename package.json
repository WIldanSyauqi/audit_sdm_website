    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
